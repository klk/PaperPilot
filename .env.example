NEXT_PUBLIC_SITE_URL=https://your-paperpilot-domain.com

# PostgreSQL for tool publishing state and future admin data.
DATABASE_URL=postgresql://paperpilot:111111@localhost:5432/paperpilotdb

# Contact form delivery. Set this to a trusted webhook endpoint, such as a
# Resend, Zapier, Make, Slack, or self-hosted support intake webhook.
CONTACT_WEBHOOK_URL=https://your-contact-webhook.example.com

# Required in production to sign administrator sessions. Generate a long random value.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Required before the first production login. Use at least 12 characters.
ADMIN_INITIAL_PASSWORD=replace-with-at-least-12-characters

# Maximum server-side upload size in bytes (default: 50 MiB).
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=500
WORKER_CONCURRENCY=2
WORKER_QUEUE_SIZE=20

# Browser used by the webpage-to-PDF worker.
# PLAYWRIGHT_CHROME_PATH=/usr/bin/chromium

# PDF -> editable Word worker. Install pdf2docx==0.5.8 and PyMuPDF==1.24.14.
# Set this to the worker virtualenv's Python executable in production.
PDF2DOCX_PYTHON=/opt/paperpilot/.venv-pdf2docx/bin/python
# Optional override when the worker script is mounted outside the app.
# PDF2DOCX_SCRIPT=/opt/paperpilot/scripts/pdf_to_docx.py

# PDF -> PowerPoint visual-fidelity worker.
PDF2PPTX_PYTHON=/opt/paperpilot/.venv-pdf2pptx/bin/python
# PDF2PPTX_SCRIPT=/opt/paperpilot/scripts/pdf_to_pptx.py
# Linux: install fonts-noto-cjk. macOS defaults to PingFang SC.
# PDF2PPTX_FONT=Noto Sans CJK SC

# PDF -> EPUB worker. It only requires PyMuPDF and generates standard EPUB3.
PDF2EPUB_PYTHON=/opt/paperpilot/.venv-pdf2epub/bin/python
# PDF2EPUB_SCRIPT=/opt/paperpilot/scripts/pdf_to_epub.py

# PDF -> editable Excel worker.
PDF2XLSX_PYTHON=/opt/paperpilot/.venv-pdf2xlsx/bin/python
# PDF2XLSX_SCRIPT=/opt/paperpilot/scripts/pdf_to_xlsx.py

# PDF -> Rich Text worker. It uses PyMuPDF and writes a Unicode-safe RTF.
PDF2RTF_PYTHON=/opt/paperpilot/.venv-pdf2rtf/bin/python
# PDF2RTF_SCRIPT=/opt/paperpilot/scripts/pdf_to_rtf.py
